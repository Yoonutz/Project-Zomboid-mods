{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project settings (.claude/settings.json)",
  "description": "A light check of the hook wiring: this file carries the Lua syntax check that runs after every edit, and a malformed settings file silently disables it. Shape per Claude Code's hooks settings; the top level stays open for other settings.",
  "type": "object",
  "properties": {
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["hooks"],
          "properties": {
            "matcher": { "type": "string", "minLength": 1 },
            "hooks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "enum": ["command", "prompt", "agent", "http", "mcp_tool"] },
                  "command": { "type": "string", "minLength": 1 },
                  "timeout": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  }
}
